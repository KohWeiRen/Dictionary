[Unit]
Description=Dictionary Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Dictionary
ExecStart=/home/pi/Dictionary/.venv/bin/python run_bot.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
