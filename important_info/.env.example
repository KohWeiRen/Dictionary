TELEGRAM_API_KEY=your-telegram-bot-token
BOT_OWNER_ID=your-numeric-telegram-chat-id
MERRIAM_WEBSTER_DICT_API=your-english-dictionary-key
MERRIAM_WEBSTER_SPANISH_DICT_API=your-spanish-dictionary-key
GEMINI_API_KEY=your-google-ai-studio-api-key
# Cloud: the SAME pooled PostgreSQL URL in Render and GitHub Actions secrets.
DATABASE_URL=postgresql://user:password@your-host/neondb?sslmode=require
REQUIRE_DATABASE=true
GEMINI_MODEL=gemini-3.8-flash
# Optional. Empty/unset enables defaults; 'none' disables fallback.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
SPANISH_LEVEL=A1
AI_DAILY_LIMIT=20
SPANISH_TTS_TLD=com.mx
# Keep the existing webhook secret when updating the Render service.
WEBHOOK_SECRET=replace-if-using-webhook-mode
# Local/Pi development: omit DATABASE_URL and set REQUIRE_DATABASE=false.
# Optional directory for local SQLite and disposable audio files.
# BOT_DATA_DIR=/home/pi/Dictionary/data
